// FRAGMENTO: adicionar dentro de match /databases/{database}/documents.
// Não substituir o conjunto completo de regras por este arquivo.
// Depende da função isOwner() já existente nas regras da Liga.

// Programação pública da Liga PAD. ID do documento: número do jogo, de 0 a 31.
// Campos obrigatórios: data (timestamp de 2000 a 2099) e atualizadoEm
// (timestamp do servidor). Somente o UID administrador pode gravar ou remover.
match /ligas/pad2026/programacao/{jogoId} {
  function programacaoValida(d) {
    return jogoId.matches('(0|[1-9]|[12][0-9]|3[01])')
      && d.keys().hasAll(['data', 'atualizadoEm'])
      && d.keys().hasOnly(['data', 'atualizadoEm'])
      && d.data is timestamp
      && d.data >= timestamp.date(2000, 1, 1)
      && d.data < timestamp.date(2100, 1, 1)
      && d.atualizadoEm == request.time;
  }

  allow read: if true;
  allow create, update: if isOwner()
    && programacaoValida(request.resource.data);
  allow delete: if isOwner();
}
